<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ritocode.Shared/Ritocode.Shared.csproj" />
    <!--
      The storage tests run against a real MinIO from the shared harness. ADR 0005 forbids ad-hoc
      fixtures, so the container lives in TestSupport beside the PostgreSQL one rather than being
      hand-rolled here.
    -->
    <ProjectReference Include="../Ritocode.TestSupport/Ritocode.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
