{
  "Api": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "EnableOpenApi": true
  },
  "Content": {
    "Seed": {
      "Enabled": true,
      "Directory": "../../content"
    }
  },
  "Authentication": {
    "DevelopmentIdentity": {
      "Enabled": true
    }
  },
  "Users": {
    "Admin": {
      "Emails": [ "developer@ritocode.local" ]
    }
  },
  "Auth": {
    "SignIn": {
      "AppOrigin": "http://localhost:5173"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple"
    }
  }
}
