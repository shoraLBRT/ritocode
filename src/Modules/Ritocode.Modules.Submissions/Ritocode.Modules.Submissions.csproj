<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module projects reference Ritocode.Shared only.
    A reference to another Ritocode.Modules.* project is an architecture violation
    and is rejected by Ritocode.Architecture.Tests. Cross-module communication goes
    through contracts published in Ritocode.Shared. See docs/adr/0002-modular-monolith-layout.md.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Ritocode.Shared/Ritocode.Shared.csproj" />
  </ItemGroup>

  <!-- Request validation, per ADR 0003: WithValidation<T>() resolves the IValidator<T> registered here. -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ritocode.Modules.Submissions.Tests" />
  </ItemGroup>

</Project>
