<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The content command line: `validate` checks a content tree against docs/CONTENT_FORMAT.md
    without a database or a host, so authors, the authoring skills and CI run the same check;
    `learner-view` prints a task exactly as a learner receives it, the input of the blind smoke
    test of the author-task skill; `export` writes the problem catalogue the frontend's build
    prerenders the public pages from.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modules/Ritocode.Modules.Content/Ritocode.Modules.Content.csproj" />
  </ItemGroup>

</Project>
