# Serves the frontend's static build (frontend/README.md, "The prerendered pages"): the path, then
# the path as a prerendered page, then the application's shell. Plain HTTP inside the Compose
# network; the edge terminates TLS.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Vite names every asset by its content, so an asset never changes under its name.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html /spa.html
	file_server
}
