# The production secrets and addresses. Copy to production.env on the server, beside
# compose.production.yml, fill it in, and keep it there: it never enters the repository.

# Which images run: a full commit (what a release names) or `main`.
RITOCODE_VERSION=main
# Where the images come from; GHCR unless a mirror is needed (ADR 0011).
RITOCODE_REGISTRY=ghcr.io/shoralbrt

# The site's domain, and Umami's — each with a DNS record pointing at the server, so Caddy can get
# their certificates.
SITE_DOMAIN=ritocode.example
UMAMI_DOMAIN=stats.ritocode.example

# PostgreSQL: the product's password, and Umami's own role's.
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=

# Umami's secret for its sessions; any long random string.
UMAMI_APP_SECRET=

# The OAuth apps of #134. Their callback addresses: https://<SITE_DOMAIN>/auth/callback/github and
# https://<SITE_DOMAIN>/auth/callback/google. A provider left empty is not offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The admin's address (docs/SPEC.md §6.2): the e-mail they sign in with.
ADMIN_EMAIL=

# Backups (backup.sh): where the seven daily dumps are kept, and the rclone remote each one is also
# copied to, off the server — an S3-compatible bucket at a Russian provider, in another region from
# the server (deploy/README.md). Empty BACKUP_REMOTE keeps the dumps on the server only.
BACKUP_DIR=/var/backups/ritocode
BACKUP_REMOTE=
