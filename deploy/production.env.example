# The production secrets and addresses. Copy to production.env on the server, beside
# compose.production.yml, fill it in, and keep it there: it never enters the repository.

# Which images run: a full commit (what a release names) or `main`.
RITOCODE_VERSION=main
# Where the images come from; GHCR unless a mirror is needed (ADR 0011).
RITOCODE_REGISTRY=ghcr.io/shoralbrt

# The site's domain, and Umami's — each with a DNS record pointing at the server, so Caddy can get
# their certificates.
SITE_DOMAIN=ritocode.example
UMAMI_DOMAIN=stats.ritocode.example

# PostgreSQL: the product's password, and Umami's own role's.
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=

# Umami's secret for its sessions; any long random string.
UMAMI_APP_SECRET=

# The admin overview's traffic panel (#306) reads Umami's API: the site's id in Umami (the same value as
# the repository variable UMAMI_WEBSITE_ID) and a token from Umami's sign-in (docs/RUNBOOK.md). Either
# empty: the panel says Umami is not configured.
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=

# The OAuth apps of #134. Their callback addresses: https://<SITE_DOMAIN>/auth/callback/github and
# https://<SITE_DOMAIN>/auth/callback/google. A provider left empty is not offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The feedback widget (ADR 0019) opens one issue per message, preferably as the GitHub App installed on
# this repository (deploy/README.md): its App ID and its private key, the whole PEM on one line with
# its line breaks written as \n, unquoted: -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
FEEDBACK_GITHUB_APP_ID=
FEEDBACK_GITHUB_APP_PRIVATE_KEY=
# The alternative to the App: a fine-grained token with Issues: write on this repository only.
# Neither set: the widget answers that feedback is not set up.
FEEDBACK_GITHUB_TOKEN=
# Turnstile's secret. Set it only together with the web image's VITE_TURNSTILE_SITE_KEY: a secret
# without a site key refuses every message, as the page sends no captcha.
TURNSTILE_SECRET_KEY=

# The admin's address (docs/SPEC.md §6.2): the e-mail they sign in with.
ADMIN_EMAIL=

# Backups (backup.sh): where the seven daily dumps are kept, and the rclone remote each one is also
# copied to, off the server — an S3-compatible bucket at a Russian provider, in another region from
# the server (deploy/README.md). Empty BACKUP_REMOTE keeps the dumps on the server only.
BACKUP_DIR=/var/backups/ritocode
BACKUP_REMOTE=
# The server's checks (check.sh, #296) alert in Telegram through a bot of their own — not bellboy's —
# made with @BotFather: its token, and the id of the chat it writes to (docs/RUNBOOK.md › Monitoring).
# Either empty: the checks run and nothing is sent. The same two values are the repository secrets the
# Monitor workflow sends with; rotate them together. The API sends a new or reopened error group through
# the same bot (#294, docs/RUNBOOK.md › An error was reported).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The checks' thresholds; the defaults are written out. A threshold set past what is possible — say
# MONITOR_DISK_FREE_PERCENT=101 — makes its check fail, to see an alert arrive; remove it afterwards.
MONITOR_DISK_PATHS=/
MONITOR_DISK_FREE_PERCENT=15
MONITOR_MEMORY_FREE_PERCENT=10
MONITOR_LOAD_PER_CPU=2
MONITOR_RESTART_WINDOW=900
MONITOR_DATABASE_MAX_MB=5120
MONITOR_DATABASE_CONNECTIONS_PERCENT=80
MONITOR_BACKUP_MAX_HOURS=26
