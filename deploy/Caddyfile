# The edge of the production server (deploy/compose.production.yml): TLS for both domains from
# Let's Encrypt, HTTP redirected to HTTPS (Caddy does both by itself), the headers that belong to
# the site as a whole, and the routes. The API sets its own strict headers on its responses (#35);
# the ones here are for the pages, plus HSTS for everything.

(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

{$SITE_DOMAIN} {
	import site_headers
	encode zstd gzip

	# Maintenance (#298): while maintenance/on exists beside this file, every request is answered
	# with the page below. deploy/release.sh creates it before migrating and removes it once the API
	# is healthy; docs/RUNBOOK.md says how to do it by hand. Checked on every request, no reload.
	@maintenance file {
		root /srv/maintenance
		try_files /on
	}
	handle @maintenance {
		error 503
	}

	# IndexNow's key file (#303): https://<domain>/<key>.txt holds the key, which is how Yandex and Bing
	# check that a call from deploy/indexnow.sh is this site's. With no key set, nothing is served.
	@indexnow_key {
		path /{$INDEXNOW_KEY}.txt
		not path /.txt
	}
	handle @indexnow_key {
		header Content-Type "text/plain; charset=utf-8"
		respond "{$INDEXNOW_KEY}" 200
	}

	# The log viewer (ADR 0020 decision 2, #295): Dozzle, which has no sign-in of its own. Every request
	# first asks the API whether its session cookie is an admin's (GET /api/v1/admin/access, the admin
	# area's own policy): 204 lets it through; the API's refusal — 401 signed out, the unknown-address 404
	# for anyone else — is the visitor's answer. A named matcher, so it stays after maintenance.
	@logs path /admin/logs /admin/logs/*
	handle @logs {
		forward_auth api:8080 {
			uri /api/v1/admin/access
		}
		# The viewer needs no cookie, so the session's never reaches it. Its live tail is a stream:
		# flushed as it comes, never buffered.
		reverse_proxy dozzle:8080 {
			header_up -Cookie
			flush_interval -1
		}
	}

	# The API: the versioned endpoints, sign-in and its callbacks, the health checks.
	@api path /api/* /auth/* /health/*
	handle @api {
		reverse_proxy api:8080
	}

	# Everything else is the static build. Its scripts are its own, Umami's and Turnstile's (the
	# feedback widget's captcha, ADR 0019, which also runs in a frame); it talks to the API on this
	# origin and to Umami's /api/send.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://{$UMAMI_DOMAIN} https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://{$UMAMI_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy web:80
	}

	# Nothing behind the edge answered (the API or the web image is down: 502 or 504), or maintenance
	# is on (503): the edge's own page (deploy/maintenance/index.html), never Caddy's bare status.
	# Always 503 with Retry-After, which tells a crawler and the pages' banner it is temporary. An
	# answer the API gave itself, a 503 of its own included, passes through untouched.
	handle_errors 502 503 504 {
		# An error starts a fresh response: the site's headers again, then the page's own.
		import site_headers
		header {
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Cache-Control "no-store"
			Retry-After "60"
		}
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}

{$UMAMI_DOMAIN} {
	import site_headers
	encode zstd gzip
	reverse_proxy umami:3000
}
