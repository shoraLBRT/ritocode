# Where the versioned API lives. Read at build time by Vite and inlined into the bundle, so a
# change needs a rebuild rather than a restart. The default matches the host command in the
# verification section of docs/PROJECT_STATE.md. `localhost`, not 127.0.0.1: the pages are served
# from localhost, and the session cookies reach them only when the API is addressed as the same host.
VITE_API_BASE_URL=http://localhost:5199/api/v1

# The easy task the landing page offers as a demo, by slug. Build-time, like the API address.
VITE_DEMO_TASK=flower-shop-daily-revenue
